{
  "name": "reposage-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "export:openapi": "cd .. && .venv/bin/python -c \"import json;from reposage.api.main import app;json.dump(app.openapi(),open('frontend/openapi.json','w'),indent=2)\"",
    "test": "vitest run",
    "test:bun": "bun test tests/unit",
    "test:e2e": "playwright test --project=mock",
    "test:e2e:stack": "playwright test -c playwright.stack.config.ts",
    "lhci": "bun run build && bun run scripts/lhci.ts",
    "mock": "bun run mock/server.ts",
    "screenshots": "SHOTS=1 playwright test e2e/mock/screenshots.spec.ts",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run test:bun && bun run build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/vue-query": "^5.104.5",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^25",
    "msw": "^2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "vite": "^6",
    "vitest": "^3",
    "vue-tsc": "^3.3.13"
  }
}
